    <loc>{{ site.url }}{{ site.baseurl }}{{ doc.url }}</loc>
    <lastmod>{{ doc.last_modified_at | default: doc.date | default: site.time | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}

  {% comment %} Collection : apropos {% endcomment %}
  {% for doc in site.apropos %}
